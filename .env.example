# Required for the visitor counter in production (Vercel).
# Create a Redis database at https://console.upstash.com and copy its REST URL/token.
# Server-only variables: never prefix these with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: use a separate key/database for Preview to keep production totals clean.
VISITOR_COUNTER_KEY=gip-space:total-visits:v1
